# ============================================================================
# Vibe — Backend Environment Variables
# Copy to .env and fill in values. Variables marked [REQUIRED] must be set.
# ============================================================================

# ─── Core ───────────────────────────────────────────────────────────────────

PORT=8080
ENV=development                  # development | staging | production
DATABASE_URL=postgres://padelsaas:padelsaas_dev@localhost:5432/padelsaas?sslmode=disable  # [REQUIRED]
JWT_SECRET=cambiar-en-produccion # [REQUIRED] min 32 random bytes: openssl rand -hex 32

# ─── App URLs ───────────────────────────────────────────────────────────────

FRONTEND_URL=http://localhost:5173   # [REQUIRED] CORS origin, email links
BACKEND_URL=http://localhost:8080    # [REQUIRED] MP webhook callbacks
COOKIE_DOMAIN=                       # Production: .vibe.com.ar
TRUSTED_PROXIES=false                # true if behind Railway/nginx proxy

# ─── MercadoPago (payments) ─────────────────────────────────────────────────

MP_ACCESS_TOKEN=                 # [REQUIRED] Marketplace API token
MP_WEBHOOK_SECRET=               # [REQUIRED] Webhook signature verification
MP_APP_ID=                       # [REQUIRED] OAuth application ID
MP_CLIENT_SECRET=                # [REQUIRED] OAuth application secret

# ─── Redis (recommended for production) ─────────────────────────────────────

REDIS_URL=                       # redis://localhost:6379 — enables distributed features

# ─── Email: Brevo API (preferred) ───────────────────────────────────────────

BREVO_API_KEY=                   # Brevo transactional email API key
BREVO_SENDER=Vibe <no-reply@vibe.com.ar>

# ─── Email: SMTP (fallback if no Brevo key) ────────────────────────────────

SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── WhatsApp Cloud API (optional) ──────────────────────────────────────────

WHATSAPP_TOKEN=                  # If empty, email-only + auto-confirm bookings
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=             # HMAC webhook signature verification

# ─── Sentry (optional) ─────────────────────────────────────────────────────

SENTRY_DSN=

# ─── Cloudflare R2 (optional, future file uploads) ─────────────────────────

R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=padelsaas

# ─── Database tuning ───────────────────────────────────────────────────────

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_MAX_IDLE_TIME=15m

# ─── Booking tuning ────────────────────────────────────────────────────────

# BOOKING_GRACE_PERIOD=15m       # Refund window after booking creation
# BOOKING_PAYMENT_EXPIRY=15m     # Auto-cancel unpaid public bookings
# PPROF_ENABLED=false            # Enable /debug/pprof (development only)
