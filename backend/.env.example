# ============================================================================
# Vibe — Backend Environment Variables
#
# Copy to .env and fill in values. Variables marked [REQUIRED] must be set or
# the API refuses to boot.
#
# This file is the whole environment surface: every variable below is read by
# internal/platform/config, and nothing outside it reads the environment. A
# value that cannot be parsed — a duration, a number, a boolean — fails the
# boot with the variable named, rather than silently falling back to the
# default shown in the comment.
#
# Every flag the API takes has an environment variable here, and the variable
# wins over the flag. Sections are ordered by what a new deployment needs
# first; variables are alphabetical within each section.
# ============================================================================

# ─── Core ───────────────────────────────────────────────────────────────────

DATABASE_URL=                    # [REQUIRED] postgres://user:pass@host:5432/db?sslmode=disable
ENV=development                  # development | staging | production
JWT_SECRET=                      # [REQUIRED] min 32 random bytes: openssl rand -hex 32
PORT=8080
REDIS_URL=                       # [REQUIRED] redis://localhost:6379 — the notification queue has no fallback

# ─── App URLs ───────────────────────────────────────────────────────────────

BACKEND_URL=http://localhost:8080    # [REQUIRED with MercadoPago] webhook and OAuth callbacks
COOKIE_DOMAIN=                       # production: .vibe.com.ar
FRONTEND_URL=http://localhost:5173   # CORS origin and email links
TRUSTED_PROXIES=false                # false | true (private ranges) | a comma-separated CIDR list

# ─── HTTP server timeouts ───────────────────────────────────────────────────

HTTP_IDLE_TIMEOUT=60s            # how long a keep-alive connection may sit idle between requests
HTTP_READ_HEADER_TIMEOUT=5s      # request line and headers alone; this is the Slowloris bound
HTTP_READ_TIMEOUT=5s             # the whole request, headers and body
HTTP_WRITE_TIMEOUT=60s           # the response; must stay above the 50s spreadsheet export budget
                                 # 0 disables any one of them, and boot refuses a write timeout
                                 # the export cannot finish inside

# ─── MercadoPago (payments) ─────────────────────────────────────────────────

MP_ACCESS_TOKEN=                 # [REQUIRED] marketplace API token
MP_APP_ID=                       # [REQUIRED with MP_ACCESS_TOKEN] OAuth application ID
MP_CLIENT_SECRET=                # [REQUIRED with MP_ACCESS_TOKEN] OAuth application secret
MP_CREDENTIAL_KEYS=              # [REQUIRED] seller-credential keyring: kid:base64key[,kid:base64key...]
                                 # generate with: go run ./cmd/mpcredkey
MP_WEBHOOK_SECRET=               # [REQUIRED with MP_ACCESS_TOKEN] webhook signature verification

# ─── Email: Brevo API (preferred) ───────────────────────────────────────────

BREVO_API_KEY=                   # Brevo transactional email API key
BREVO_SENDER=Vibe <no-reply@vibe.com.ar>

# ─── Email: SMTP (fallback when there is no Brevo key) ──────────────────────

SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_USERNAME=

# ─── WhatsApp Cloud API (optional) ──────────────────────────────────────────

WHATSAPP_APP_SECRET=             # HMAC webhook signature verification
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=                  # empty: email only, and public bookings auto-confirm
WHATSAPP_VERIFY_TOKEN=

# ─── Google (optional) ──────────────────────────────────────────────────────

GOOGLE_MAPS_API=                 # Places API key for the address autocomplete
GOOGLE_OAUTH_CLIENT_ID=          # empty: Sign in with Google answers 503

# ─── Cloudflare Turnstile (optional) ────────────────────────────────────────

TURNSTILE_SECRET_KEY=            # empty: register, login and forgot-password take no bot check

# ─── Cloudflare R2 (optional, image uploads) ────────────────────────────────

R2_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=vibe
R2_PUBLIC_URL=                   # public base URL images are served from
R2_SECRET_KEY=

# ─── Lead capture (optional) ────────────────────────────────────────────────

LEADS_ABANDONED_WEBHOOK_TOKEN=   # shared token the webhook expects
LEADS_ABANDONED_WEBHOOK_URL=     # Google Apps Script /exec URL; empty drops the captures

# ─── Observability ──────────────────────────────────────────────────────────

PPROF_ENABLED=false              # /debug/pprof, development only
REQUEST_LOG_SAMPLE=1             # log one successful request in N; failures and slow requests are never sampled
SENTRY_DSN=                      # empty: Sentry is not initialised
SENTRY_RELEASE=                  # empty: vibe@<build version stamped by the Dockerfile>

# ─── Database tuning ────────────────────────────────────────────────────────

DB_AUTO_MIGRATE=false            # apply the embedded migration chain before serving
DB_MAX_IDLE_CONNS=10
DB_MAX_IDLE_TIME=15m
DB_MAX_OPEN_CONNS=25
DB_MIGRATOR_URL=                 # DSN migrations run as; empty means DATABASE_URL
DB_SLOW_QUERY_THRESHOLD=500ms    # warn on any single query slower than this; 0 disables it
DB_STATEMENT_TIMEOUT=15s         # server-side backstop for a query no context managed to cancel

# ─── Rate limiter ───────────────────────────────────────────────────────────

LIMITER_BURST=20
LIMITER_ENABLED=true
LIMITER_RPS=10

# ─── Booking rules ──────────────────────────────────────────────────────────

BOOKING_CANCELLATION_WINDOW=24h  # default window before game start
BOOKING_GRACE_PERIOD=15m         # refund window after a booking is created
BOOKING_LINK_TOKEN_BUFFER=24h    # how long past a booking's end its link token stays valid
BOOKING_PAYMENT_EXPIRY=15m       # auto-cancel an unpaid public booking after this
BOOKING_SLOT_LOCK_TTL=15m        # must be >= BOOKING_PAYMENT_EXPIRY
LIMITS_MAX_COMPLEXES=4           # complexes per account

# ─── Product flags ──────────────────────────────────────────────────────────

FEATURE_FLAGS=                   # comma-separated names, each on; name=false turns one off
