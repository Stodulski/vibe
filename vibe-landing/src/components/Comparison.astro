---
/**
 * Three options compared across five criteria: that is a table, and saying so in
 * the markup is what lets a screen reader announce "fila 2, columna Vibe". As
 * three separate lists it read as fifteen unrelated sentences.
 *
 * A <table> also aligns rows by itself, so the subgrid that used to force equal
 * row heights across independent columns is gone.
 */
const COLUMNAS = [
  { id: 'vibe', nombre: 'Vibe' },
  { id: 'whatsapp', nombre: 'WhatsApp' },
  { id: 'atc', nombre: 'ATC Sports' },
];

/** Each row is one criterion, read left to right in column order. */
const FILAS = [
  [
    { estado: 'good', texto: '$0 de costo fijo, para siempre' },
    { estado: 'neutral', texto: '$0, pero perdés horas a mano' },
    /* Sin monto a proposito: el abono es lo que marca la diferencia con Vibe y se
       sostiene solo. Un precio ajeno envejece cada vez que ellos ajustan la lista.
       Los planes verificados estan en src/data/competencia.ts. */
    { estado: 'bad', texto: 'Abono mensual fijo' },
  ],
  [
    { estado: 'good', texto: 'Solo la comisión de MercadoPago' },
    { estado: 'bad', texto: 'Nadie cobra online, todo a mano' },
    { estado: 'bad', texto: 'Se paga siempre, haya reservas o no' },
  ],
  [
    { estado: 'good', texto: 'La seña se cobra automáticamente' },
    { estado: 'bad', texto: 'Cobrás la seña vos, a mano' },
    { estado: 'bad', texto: 'Depende de que el complejo lo configure' },
  ],
  [
    { estado: 'good', texto: 'Reservan solos, a cualquier hora' },
    { estado: 'bad', texto: 'Reservan por WhatsApp, si contestás' },
    { estado: 'good', texto: 'También reservan solos, a cualquier hora' },
  ],
  [
    { estado: 'good', texto: 'Recordatorios automáticos por WhatsApp y mail' },
    { estado: 'bad', texto: 'Recordás vos, turno por turno' },
    { estado: 'bad', texto: 'No figura en sus funciones publicadas' },
  ],
];
---
<section class="comparison" id="comparacion">
 <div class="container">
  <div class="comparison-header">
   <div class="section-label anim">¿Por qué Vibe?</div>
   <h2 class="section-title anim anim-d1">Dejá de comparar a ciegas</h2>
   <p class="section-desc anim anim-d2">Así se ve Vibe al lado de seguir gestionando a mano y de ATC Sports, un software de gestión pago usado por complejos en Argentina.</p>
  </div>
  <div class="comparison-tabs anim" role="tablist" aria-label="Elegí qué comparar">
   {COLUMNAS.map((c, i) => (
    <button type="button" class:list={['comparison-tab', i === 0 && 'active']} data-target={c.id} role="tab" aria-selected={i === 0 ? 'true' : 'false'}>{c.nombre}</button>
   ))}
  </div>
  <table class="comparison-table anim anim-d3" data-shown="vibe">
   <caption class="sr-only">Vibe comparado con gestionar por WhatsApp y con ATC Sports</caption>
   <thead>
    <tr>
     <th scope="col" data-col="vibe">
      <div class="comparison-th-inner">
       <img src="/logo.svg" width="120" height="84" alt="Vibe" loading="lazy" />
      </div>
     </th>
     <th scope="col" data-col="whatsapp">
      <div class="comparison-th-inner">
       <svg viewBox="0 0 32 32" width="66" height="66" fill="#25D366" aria-hidden="true"><path d="M16.004 0C7.176 0 .002 7.174.002 16.002c0 2.822.737 5.58 2.137 8.012L.009 32l8.188-2.09a15.95 15.95 0 0 0 7.807 2.032C24.83 31.942 32 24.768 32 15.94 32 7.174 24.83 0 16.004 0zm0 29.314a13.28 13.28 0 0 1-7.1-2.048l-.508-.302-4.87 1.244 1.302-4.732-.338-.533A13.27 13.27 0 0 1 2.63 16.002c0-7.38 6.004-13.374 13.374-13.374 7.38 0 13.368 5.994 13.368 13.374 0 7.37-5.988 13.312-13.368 13.312zm7.326-10.012c-.4-.2-2.372-1.172-2.74-1.306-.368-.132-.636-.2-.904.2s-1.038 1.306-1.272 1.574c-.234.268-.468.3-.868.1s-1.692-.624-3.222-1.988c-1.192-1.062-1.996-2.374-2.23-2.774-.234-.4-.024-.616.176-.816.18-.18.4-.468.6-.702.2-.234.268-.4.4-.668.134-.268.068-.502-.032-.702-.1-.2-.904-2.178-1.238-2.982-.326-.784-.658-.678-.904-.69l-.77-.012c-.268 0-.702.1-1.07.502-.368.4-1.404 1.372-1.404 3.346 0 1.974 1.438 3.882 1.638 4.15.2.268 2.826 4.314 6.852 6.05.958.414 1.704.66 2.286.846.96.306 1.834.262 2.524.16.77-.116 2.372-.97 2.706-1.906.334-.936.334-1.738.234-1.906-.1-.168-.368-.268-.77-.468z"/></svg>
       <span class="sr-only">WhatsApp</span>
      </div>
     </th>
     <th scope="col" data-col="atc">
      <div class="comparison-th-inner">
       <img src="/atc-sports-logo.svg" width="183" height="72" alt="ATC Sports" loading="lazy" />
      </div>
     </th>
    </tr>
   </thead>
   <tbody>
    {FILAS.map(fila => (
     <tr>
      {fila.map((celda, i) => (
       <td class={`comparison-${celda.estado}`} data-col={COLUMNAS[i].id}>{celda.texto}</td>
      ))}
     </tr>
    ))}
   </tbody>
  </table>
 </div>
</section>
