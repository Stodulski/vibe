# API base URL (must include /api/v1 prefix)
# Development: use relative path (proxied by Vite)
# Production: use absolute URL (e.g., https://api.vibe.com.ar/api/v1)
VITE_API_URL=/api/v1

# App URL (used for canonical URLs and OG tags)
VITE_APP_URL=http://localhost:5173

# Sentry DSN (optional, leave empty to disable)
VITE_SENTRY_DSN=
