          "value": "noindex"
        }
      ]
    },
    {
      "source": "/:slug/book",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/:slug/book/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "installCommand": "pnpm install --frozen-lockfile"
}
