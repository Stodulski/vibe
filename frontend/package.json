{
  "name": "vibe-client",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11"
  },
  "browserslist": [
    "chrome >= 111",
    "safari >= 16.4",
    "firefox >= 128",
    "edge >= 111"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --force",
    "gen:api": "openapi-typescript ../backend/internal/openapi/openapi.yaml -o src/shared/types/api.generated.ts",
    "gen:api:check": "pnpm gen:api && git diff --exit-code -- src/shared/types/api.generated.ts",
    "format": "prettier --write . '!src/shared/types/**' '!src/shared/schemas/**'",
    "format:check": "prettier --check . '!src/shared/types/**' '!src/shared/schemas/**'",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--max-old-space-size=3072 vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:ui": "vitest --coverage --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:lighthouse": "lhci autorun",
    "test:load": "pnpm dlx artillery@2 run ../backend/tests/load/api-load.yml --output load-results.json && pnpm dlx artillery@2 report load-results.json",
    "knip": "knip",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@marsidev/react-turnstile": "1.6.1",
    "@sentry/react": "^10.74.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "ky": "^2.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.44.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.87.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.3",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
