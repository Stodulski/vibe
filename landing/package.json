{
  "name": "vibe-landing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-markdown.mjs",
    "preview": "astro preview",
    "test": "node tests/smoke.mjs",
    "check:mp": "node scripts/check-mercadopago.mjs",
    "seo:gate": "node scripts/seo-gate.mjs --dist",
    "seo:prod": "node scripts/seo-gate.mjs --url https://vibe.com.ar",
    "predeploy": "npm run build && npm run seo:gate",
    "test:setup": "playwright install chromium"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.5",
    "astro": "^7.2.4"
  },
  "devDependencies": {
    "@vercel/node": "^11.0.0",
    "playwright": "^1.62.1",
    "turndown": "^7.2.4"
  }
}
