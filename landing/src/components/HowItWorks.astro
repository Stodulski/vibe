---
import Screenshot from './Screenshot.astro';

/*
 * Four steps side by side, each opening with the screen it talks about instead of a
 * generic icon. The pictures are details of real captures: `crop` is the region shown,
 * in the capture's own pixels (`rx`/`ry` its top-left corner, `rw` its width), and
 * `natural` is the capture's size when it is not the 1669x869 desktop one.
 *
 * `how-step-node` is a name scripts/build-markdown.mjs drops: the number is the order
 * of the list, which the Markdown twin already states by listing the steps in order.
 */
const STEPS = [
  {
    title: 'Cargá tu complejo',
    text: 'Canchas, horarios y precios. Conectás MercadoPago y las señas online quedan andando.',
    detail: 'Asistente paso a paso',
    shot: { name: 'precios-por-cancha-y-horario', alt: 'Canchas cargadas en Vibe, cada una con su deporte y su descripción', crop: { rw: 380, rx: 118, ry: 150 } },
  },
  {
    title: 'Compartí tu link',
    text: 'Tu complejo tiene su propia página. Pegala en Instagram, en Google Maps y en el WhatsApp.',
    detail: 'vibe.com.ar/c/tu-complejo',
    shot: { name: 'reserva-desde-el-celular', alt: 'Página propia de un complejo en Vibe, con su nombre, su dirección y su teléfono', crop: { rw: 320, rx: 0, ry: 196 }, natural: { w: 320, h: 1400 } },
  },
  {
    title: 'Recibí las reservas',
    text: 'Entran reservas con seña, desde el celular. Las ves en la grilla, con lo que falta cobrar.',
    detail: 'Confirmación y recordatorio automáticos',
    shot: { name: 'panel-reservas-canchas', alt: 'Reservas del día en la grilla de Vibe, cada una en su cancha y su horario', crop: { rw: 420, rx: 250, ry: 100 } },
  },
  {
    title: 'Abrí la caja y vendé',
    text: 'Cobrás lo que falta, vendés lo del bar y al cerrar el turno la cuenta ya está hecha.',
    detail: 'Arqueo al cierre',
    shot: { name: 'caja-turno', alt: 'Caja del turno en Vibe con el efectivo esperado y los movimientos del día', crop: { rw: 400, rx: 196, ry: 186 } },
  },
];
---
<!-- ========== CÓMO FUNCIONA ========== -->
<section class="how" id="como-funciona">
 <div class="container">
  <div class="how-header">
   <div class="section-label anim">Cómo funciona</div>
   <h2 class="section-title anim anim-d1">Tu complejo andando en cuatro pasos</h2>
   <p class="section-desc anim anim-d2">Si usás WhatsApp, usás Vibe. Lo cargás vos y podés recibir reservas el mismo día.</p>
  </div>

  <div class="how-steps">
   {STEPS.map((step, i) => {
    const { crop, natural } = step.shot;
    const vars = `--rw:${crop.rw};--rx:${crop.rx};--ry:${crop.ry}` + (natural ? `;--nw:${natural.w};--nh:${natural.h}` : '');
    return (
     <div class={`how-step anim anim-d${i + 1}`}>
      <div class="how-step-node"><span class="how-step-num">{i + 1}</span></div>
      <h3>{step.title}</h3>
      <p>{step.text}</p>
      <p class="step-detail">{step.detail}</p>
      {/* After its step in the markup, so the page reads heading first; the styles lift
          it to the top of the column. */}
      <div class="shot how-step-shot" style={vars}>
       <div class="shot-canvas">
        {natural
         ? <Screenshot variant="single" name={step.shot.name} width={natural.w} height={natural.h} alt={step.shot.alt} />
         : <Screenshot variant="desktop" name={step.shot.name} alt={step.shot.alt} />}
       </div>
      </div>
     </div>
    );
   })}
  </div>
 </div>
</section>
