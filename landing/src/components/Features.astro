---
import Screenshot from './Screenshot.astro';

/*
 * The seven modules, one slide each, on a full-width track: the current slide in the
 * middle with its neighbours peeking dimmed at the sides. main.js moves the track.
 *
 * Each capture is shown at a fixed scale where the panel's own type reads at about
 * 12px, starting at the top-left corner of the part the text talks about: `focus` is
 * that corner in the capture's own pixels. A wider frame shows more past it; a phone
 * shows less, but never smaller. See .shot--focus in home.css.
 *
 * Every module is in the markup, so the page reads complete without JavaScript and in
 * the Markdown twin. The clones around them only exist for the loop: they repeat a
 * slide a reader already met, so they are hidden from assistive tech, their captures
 * carry no alt, and scripts/build-markdown.mjs drops them (ft-block--clone).
 */
const MODULES = [
  {
    id: 'reservas',
    tab: 'Reservas',
    title: 'Reservas que entran solas, a cualquier hora',
    text: 'Una página propia donde tus clientes eligen cancha y horario sin escribirte. Pagan la seña o el total con Mercado Pago al reservar.',
    bullets: ['Sin app ni registro para el que reserva', 'Nunca dos reservas en el mismo turno', 'Si cancela a tiempo, la seña vuelve sola'],
    shot: 'panel-reservas-canchas',
    alt: 'Panel real de reservas de Vibe con turnos confirmados y seña pagada, agrupados por mañana, tarde y noche',
    focus: { x: 196, y: 64 },
  },
  {
    id: 'turnos-fijos',
    tab: 'Turnos fijos',
    title: 'El turno de todas las semanas, cargado una vez',
    text: 'Cargás el turno fijo de un cliente y Vibe lo reserva cada semana. La cancha queda tomada en la grilla.',
    bullets: ['Cancelás una fecha sin tocar las demás', 'Terminás el turno fijo desde la fecha que elijas', 'Cada fecha se cobra como una reserva más'],
    shot: 'turnos-fijos',
    alt: 'Grilla de reservas de Vibe con un turno fijo semanal que ocupa la misma cancha y el mismo horario cada semana',
    focus: { x: 1150, y: 0 },
  },
  {
    id: 'canchas-abiertas',
    tab: 'Canchas abiertas',
    title: 'Canchas abiertas para que se armen partidos',
    text: 'Publicás un horario con las canchas que quieras y los jugadores se anotan desde tu página. Pagan al anotarse con Mercado Pago.',
    bullets: ['Elegís cupo, precio y canchas', 'Esas canchas quedan bloqueadas para otras reservas', 'Si cancelás, a cada uno le vuelve lo que pagó'],
    shot: 'canchas-abiertas',
    alt: 'Cancha abierta publicada en Vibe con su horario, sus canchas, el cupo y la lista de jugadores anotados',
    focus: { x: 1150, y: 0 },
  },
  {
    id: 'torneos',
    tab: 'Torneos',
    title: 'Torneos con inscripción, cuadro y resultados',
    text: 'Armás las categorías, las parejas se inscriben y pagan desde tu página, y Vibe arma el cuadro.',
    bullets: ['Zonas y eliminación directa', 'Cada partido ocupa su cancha en la grilla', 'Los jugadores siguen el cuadro y los resultados desde tu página'],
    shot: 'torneos-cuadro',
    alt: 'Torneo en Vibe con las zonas de una categoría, sus resultados y las parejas que clasifican',
    focus: { x: 200, y: 60 },
  },
  {
    id: 'caja',
    tab: 'Caja',
    title: 'Caja por turno y arqueo al cierre',
    text: 'Abrís el turno con el efectivo del cajón. Al cerrar, Vibe ya hizo la cuenta.',
    bullets: ['Ingresos y egresos por categoría: insumos, sueldos, servicios, retiros', 'Los cobros en efectivo y las ventas entran solos', 'Al cerrar: esperado contra contado, con sobrante o faltante'],
    shot: 'caja-turno',
    alt: 'Caja abierta en Vibe con el efectivo inicial, los movimientos del turno y el efectivo esperado',
    focus: { x: 196, y: 84 },
  },
  {
    id: 'bar',
    tab: 'Bar',
    title: 'El bar, con el stock siempre al día',
    text: 'Cargás tu catálogo una vez. Cada venta descuenta stock y entra en la caja del turno.',
    bullets: ['Armás el carrito y cobrás en el mostrador', 'Si un producto quedó en cero, te avisa y la venta sale igual', 'Aviso de stock bajo en el dashboard, con el mínimo que vos definís'],
    shot: 'vender-mostrador',
    alt: 'Pantalla Vender de Vibe con el catálogo, el carrito y un aviso de stock',
    focus: { x: 1246, y: 144 },
  },
  {
    id: 'reportes',
    tab: 'Reportes',
    title: 'Reportes del día y del mes',
    text: 'Ves el día en el dashboard y bajás el mes en Excel para tu contador.',
    bullets: ['Ingresos, ocupación por horario y la caja abierta', 'Reporte mensual por método de pago y por cancha', 'Excel con los pagos y la caja del mes'],
    shot: 'dashboard-complejo-deportivo',
    alt: 'Dashboard real de Vibe con las reservas, los ingresos, la ocupación y los medios de pago del día',
    focus: { x: 200, y: 76 },
  },
];

type Module = (typeof MODULES)[number];
const last = MODULES.length - 1;
/* Two clones on each side. The ones right next to the real slides are where a wrap
   lands before main.js snaps to the matching real slide; the outer ones are only there
   so those have a neighbour to peek at while they are centred. */
const before: Array<{ m: Module; kind: string }> = [
  { m: MODULES[last - 1], kind: 'decorative' },
  { m: MODULES[last], kind: 'before' },
];
const after: Array<{ m: Module; kind: string }> = [
  { m: MODULES[0], kind: 'after' },
  { m: MODULES[1], kind: 'decorative' },
];
---
<!-- ========== MÓDULOS ========== -->
<section class="features" id="funcionalidades">
 <div class="container">
  <div class="features-header">
   <div class="section-label anim">Módulos</div>
   <h2 class="section-title anim anim-d1">Siete módulos en un solo panel,<br><em>gratis para tu complejo.</em></h2>
   <p class="section-desc anim anim-d2">Elegí un módulo y mirá cómo se ve en el panel.</p>
  </div>

  <div class="ft-carousel">
   <button type="button" class="ft-arrow ft-arrow-prev" aria-label="Módulo anterior"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
   <div class="ft-viewport">
    <div class="ft-stack">
     {before.map(({ m, kind }) => (
      <div class="ft-block ft-block--clone" data-clone={kind} aria-hidden="true">
       <div class="ft-block-text">
        <h3>{m.title}</h3>
        <p>{m.text}</p>
        <ul class="ft-bullets">{m.bullets.map(b => <li>{b}</li>)}</ul>
       </div>
       <div class="ft-block-visual">
        <div class="browser-frame shot shot--focus" style={`--fx:${m.focus.x};--fy:${m.focus.y}`}>
         <div class="shot-canvas"><Screenshot name={m.shot} alt="" /></div>
        </div>
       </div>
      </div>
     ))}

     {MODULES.map((m, i) => (
      <div class:list={['ft-block', i === 0 && 'active']} id={`modulo-${m.id}`} aria-current={i === 0 ? 'true' : undefined}>
       <div class="ft-block-text">
        <h3>{m.title}</h3>
        <p>{m.text}</p>
        <ul class="ft-bullets">{m.bullets.map(b => <li>{b}</li>)}</ul>
       </div>
       <div class="ft-block-visual">
        <div class="browser-frame shot shot--focus" style={`--fx:${m.focus.x};--fy:${m.focus.y}`}>
         <div class="shot-canvas"><Screenshot name={m.shot} alt={m.alt} /></div>
        </div>
       </div>
      </div>
     ))}

     {after.map(({ m, kind }) => (
      <div class="ft-block ft-block--clone" data-clone={kind} aria-hidden="true">
       <div class="ft-block-text">
        <h3>{m.title}</h3>
        <p>{m.text}</p>
        <ul class="ft-bullets">{m.bullets.map(b => <li>{b}</li>)}</ul>
       </div>
       <div class="ft-block-visual">
        <div class="browser-frame shot shot--focus" style={`--fx:${m.focus.x};--fy:${m.focus.y}`}>
         <div class="shot-canvas"><Screenshot name={m.shot} alt="" /></div>
        </div>
       </div>
      </div>
     ))}
    </div>
   </div>
   <button type="button" class="ft-arrow ft-arrow-next" aria-label="Siguiente módulo"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
  </div>

  <!-- One dot per module, named after it. `ft-dots` is a name scripts/build-markdown.mjs
       drops as a control. -->
  <div class="ft-dots" role="group" aria-label="Módulos">
   {MODULES.map((m, i) => (
    <button type="button" class:list={['ft-dot', i === 0 && 'active']} aria-current={i === 0 ? 'true' : undefined} aria-controls={`modulo-${m.id}`} aria-label={`Ir a: ${m.tab}`}></button>
   ))}
  </div>

  <p class="ft-tutoriales anim anim-d4">
   Mirá cada pantalla explicada paso a paso en los <a href="/tutoriales">tutoriales</a>.
  </p>
 </div>
</section>
