---
/**
 * Three options compared across five criteria: that is a table, and saying so in
 * the markup is what lets a screen reader announce "fila 2, columna Vibe". As
 * three separate lists it read as fifteen unrelated sentences.
 *
 * A <table> also aligns rows by itself, so the subgrid that used to force equal
 * row heights across independent columns is gone.
 */
import {
  ATC_PRUEBA_GRATIS_DIAS,
  ATC_CITA_SIN_COMISIONES,
  ATC_CITA_PRUEBA,
  ATC_CITA_RESERVAS_ONLINE,
  ATC_CITA_PAGO_AL_RESERVAR,
  ATC_CITA_CAJA,
  ATC_CITA_BAR,
  ATC_CITA_STOCK,
  ATC_CITA_RECORDATORIOS,
} from '../data/competencia';

const COLUMNAS = [
  { id: 'vibe', nombre: 'Vibe' },
  { id: 'whatsapp', nombre: 'WhatsApp' },
  { id: 'atc', nombre: 'ATC Sports' },
];

/*
 * Each row is one criterion, read left to right in column order, under the label in
 * `criterio`. An answer that does the job is drawn in green with a check beside it, so it
 * stands out without leaning on colour alone. A check means
 * "this option does it"; WhatsApp gets none, since every answer there is work done by
 * hand. Nothing is scored in red: the table describes each option.
 *
 * Every ATC Sports cell is written from a quote in src/data/competencia.ts, taken from
 * their own pages (ATC_FUNCIONES_VERIFICADO), and names it in `citas`. That field is not
 * rendered: it ties the cell to its source, so dropping a constant breaks the build here,
 * which is the cue to put "Sin dato publicado" back in that cell. ATC gets the check
 * wherever it publishes the feature; Costo is a price model, not a feature, so it stays
 * unmarked.
 */
type Celda = { texto: string; marca?: true; citas?: string[] };
const FILAS: { criterio: string; celdas: Celda[] }[] = [
  {
    criterio: 'Costo',
    celdas: [
      { texto: 'Gratis para tu complejo', marca: true },
      { texto: 'Gratis, lo llevás a mano' },
      /* Sin monto a propósito: un precio ajeno envejece cada vez que ellos ajustan la
         lista. Los planes verificados están en src/data/competencia.ts. */
      {
        texto: `Abono mensual fijo, sin comisiones y con ${ATC_PRUEBA_GRATIS_DIAS} días de prueba`,
        citas: [ATC_CITA_SIN_COMISIONES, ATC_CITA_PRUEBA],
      },
    ],
  },
  {
    criterio: 'Reservas',
    celdas: [
      { texto: 'Tus clientes reservan a cualquier hora', marca: true },
      { texto: 'Por WhatsApp, cuando contestás' },
      { texto: 'Cada complejo tiene su sitio con reservas online, 24/7', marca: true, citas: [ATC_CITA_RESERVAS_ONLINE] },
    ],
  },
  {
    criterio: 'Seña',
    celdas: [
      { texto: 'Se paga con Mercado Pago al reservar', marca: true },
      { texto: 'Revisás cada comprobante a mano' },
      /* La cita está en su sección "Integración con Mercado Pago". */
      { texto: 'Las reservas online se pagan en el momento, con Mercado Pago', marca: true, citas: [ATC_CITA_PAGO_AL_RESERVAR] },
    ],
  },
  {
    criterio: 'Caja y bar',
    celdas: [
      { texto: 'Caja por turno con arqueo, y venta con stock', marca: true },
      { texto: 'Cuaderno o planilla' },
      {
        texto: 'Control de caja diario, consumos de bar y stock',
        marca: true,
        citas: [ATC_CITA_CAJA, ATC_CITA_BAR, ATC_CITA_STOCK],
      },
    ],
  },
  {
    criterio: 'Recordatorios',
    celdas: [
      { texto: 'Recordatorio automático por mail, dos horas antes', marca: true },
      { texto: 'Los mandás vos, uno por uno' },
      /* La cita está en la lista de su módulo de WhatsApp. */
      { texto: 'Recordatorios de reservas por WhatsApp', marca: true, citas: [ATC_CITA_RECORDATORIOS] },
    ],
  },
];
---
<section class="comparison" id="comparacion">
 <div class="container">
  <div class="comparison-header">
   <div class="section-label anim">¿Por qué Vibe?</div>
   <h2 class="section-title anim anim-d1">Tres formas de manejar el mismo complejo</h2>
   <p class="section-desc anim anim-d2">Cómo se resuelve cada cosa con Vibe, a mano y con ATC Sports.</p>
  </div>
  <div class="comparison-tabs anim" role="tablist" aria-label="Elegí qué comparar">
   {COLUMNAS.map((c, i) => (
    <button type="button" class:list={['comparison-tab', i === 0 && 'active']} data-target={c.id} role="tab" aria-selected={i === 0 ? 'true' : 'false'}>{c.nombre}</button>
   ))}
  </div>
  <table class="comparison-table anim anim-d3" data-shown="vibe">
   <caption class="sr-only">Vibe comparado con gestionar por WhatsApp y planilla, y con ATC Sports</caption>
   <thead>
    <tr>
     <th scope="col" class="comparison-corner"><span class="sr-only">Criterio</span></th>
     <!-- Each column is named in words under its mark. Where the mark is an image its
          alt already says the name, so the visible word is hidden from assistive tech
          instead of being read twice. -->
     <th scope="col" data-col="vibe">
      <div class="comparison-th-inner">
       <img src="/logo.svg" width="57" height="40" alt="Vibe" loading="lazy" />
       <span class="comparison-th-name" aria-hidden="true">Vibe</span>
      </div>
     </th>
     <th scope="col" data-col="whatsapp">
      <div class="comparison-th-inner">
       <svg viewBox="0 0 32 32" width="40" height="40" fill="currentColor" aria-hidden="true"><path d="M16.004 0C7.176 0 .002 7.174.002 16.002c0 2.822.737 5.58 2.137 8.012L.009 32l8.188-2.09a15.95 15.95 0 0 0 7.807 2.032C24.83 31.942 32 24.768 32 15.94 32 7.174 24.83 0 16.004 0zm0 29.314a13.28 13.28 0 0 1-7.1-2.048l-.508-.302-4.87 1.244 1.302-4.732-.338-.533A13.27 13.27 0 0 1 2.63 16.002c0-7.38 6.004-13.374 13.374-13.374 7.38 0 13.368 5.994 13.368 13.374 0 7.37-5.988 13.312-13.368 13.312zm7.326-10.012c-.4-.2-2.372-1.172-2.74-1.306-.368-.132-.636-.2-.904.2s-1.038 1.306-1.272 1.574c-.234.268-.468.3-.868.1s-1.692-.624-3.222-1.988c-1.192-1.062-1.996-2.374-2.23-2.774-.234-.4-.024-.616.176-.816.18-.18.4-.468.6-.702.2-.234.268-.4.4-.668.134-.268.068-.502-.032-.702-.1-.2-.904-2.178-1.238-2.982-.326-.784-.658-.678-.904-.69l-.77-.012c-.268 0-.702.1-1.07.502-.368.4-1.404 1.372-1.404 3.346 0 1.974 1.438 3.882 1.638 4.15.2.268 2.826 4.314 6.852 6.05.958.414 1.704.66 2.286.846.96.306 1.834.262 2.524.16.77-.116 2.372-.97 2.706-1.906.334-.936.334-1.738.234-1.906-.1-.168-.368-.268-.77-.468z"/></svg>
       <span class="comparison-th-name">WhatsApp</span>
      </div>
     </th>
     <th scope="col" data-col="atc">
      <div class="comparison-th-inner">
       <img class="comparison-th-rival" src="/atc-sports-logo.svg" width="78" height="30" alt="ATC Sports" loading="lazy" />
       <span class="comparison-th-name" aria-hidden="true">ATC Sports</span>
      </div>
     </th>
    </tr>
   </thead>
   <tbody>
    {FILAS.map(fila => (
     <tr>
      <th scope="row" class="comparison-criterio">{fila.criterio}</th>
      {fila.celdas.map(({ texto, marca }, i) => (
       <td class={marca ? 'comparison-good' : 'comparison-neutral'} data-col={COLUMNAS[i].id}>
        {marca && <svg class="comparison-check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>}
        <span>{texto}</span>
       </td>
      ))}
     </tr>
    ))}
   </tbody>
  </table>
 </div>
</section>
