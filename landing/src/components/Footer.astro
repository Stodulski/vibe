 <div class="footer-inner">
  <a class="footer-logo" href={logoHref}>
   <img alt={logoAlt} class="footer-logo-img" height="28" loading="lazy" src="/logo.svg" width="40"/>
  </a>
  <ul class="footer-links">
   <li>
    <a href={`${linkPrefix}#funcionalidades`}>
     Funcionalidades
    </a>
   </li>
   <li>
    <a href={`${linkPrefix}#como-funciona`}>
     {comoFuncionaLabel}
    </a>
   </li>
   <li>
    <a href={`${linkPrefix}#precio`}>
     Precio
    </a>
   </li>
   <li>
    <a href={`${linkPrefix}#faq`}>
     FAQ
    </a>
   </li>
   <li>
    <a href="/guias">
     Guías
    </a>
   </li>
   <li>
    <a href="/tutoriales">
     Tutoriales
    </a>
   </li>
   <li>
    <a href="/privacidad">
     Privacidad
    </a>
   </li>
   <li>
    <a href="/terminos">
