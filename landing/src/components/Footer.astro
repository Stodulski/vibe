---
export interface Props {
  linkPrefix?: string;
  logoHref?: string;
  logoAlt?: string;
  comoFuncionaLabel?: string;
}

const {
  linkPrefix = '',
  logoHref = '#',
  logoAlt = 'Vibe',
  comoFuncionaLabel = 'Cómo funciona',
} = Astro.props;
---
