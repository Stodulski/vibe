<section class="hero" id="inicio">
 <div class="hero-inner">
  <!-- Decorative sport emojis drifting around the centered copy. Purely
       presentational (the hero copy already names the sports), so it is hidden
       from assistive tech and sits behind the content.

       Images, not emoji characters: each platform draws emoji with its own
       font, so the same character looked different on iPhone, Android and
       Windows. These are Microsoft's Fluent Emoji 3D (MIT, license beside the
       files in /emoji), resized to 160px WebP — twice the largest rendered
       size, so they stay sharp on 2x screens. Low fetch priority: they are
       decoration and must not compete with the headline for first paint. -->
  <div class="hero-orbit" aria-hidden="true">
   <div class="hero-orbit-glow"></div>
   <span class="orbit-item orbit-item-1"><span class="orbit-path"><img class="sport-emoji" src="/emoji/soccer-ball.webp" alt="" width="192" height="192" decoding="async" fetchpriority="low"></span></span>
   <span class="orbit-item orbit-item-2"><span class="orbit-path"><img class="sport-emoji" src="/emoji/basketball.webp" alt="" width="192" height="192" decoding="async" fetchpriority="low"></span></span>
   <span class="orbit-item orbit-item-3"><span class="orbit-path"><img class="sport-emoji" src="/emoji/tennis.webp" alt="" width="192" height="192" decoding="async" fetchpriority="low"></span></span>
   <span class="orbit-item orbit-item-4"><span class="orbit-path"><img class="sport-emoji" src="/emoji/volleyball.webp" alt="" width="192" height="192" decoding="async" fetchpriority="low"></span></span>
   <span class="orbit-item orbit-item-5"><span class="orbit-path"><img class="sport-emoji" src="/emoji/field-hockey.webp" alt="" width="192" height="192" decoding="async" fetchpriority="low"></span></span>
   <span class="orbit-item orbit-item-6"><span class="orbit-path"><img class="sport-emoji" src="/emoji/rugby-football.webp" alt="" width="192" height="192" decoding="async" fetchpriority="low"></span></span>
   <span class="orbit-item orbit-item-7"><span class="orbit-path"><img class="sport-emoji" src="/emoji/trophy.webp" alt="" width="192" height="192" decoding="async" fetchpriority="low"></span></span>
   <span class="orbit-item orbit-item-8"><span class="orbit-path"><img class="sport-emoji" src="/emoji/goal-net.webp" alt="" width="192" height="192" decoding="async" fetchpriority="low"></span></span>
   <span class="orbit-item orbit-item-9"><span class="orbit-path"><img class="sport-emoji" src="/emoji/running-shoe.webp" alt="" width="192" height="192" decoding="async" fetchpriority="low"></span></span>
  </div>
  <div class="hero-content">
   <div class="section-label anim anim-d1">Reservas online y cobro de señas</div>
   <h1 class="anim anim-d2">Digitalización de<br><em>complejos deportivos</em></h1>
   <p class="hero-subtitle anim anim-d3">Tu cliente elige cancha y horario, y paga la seña con MercadoPago. La plata entra directo a tu cuenta, sin costo fijo para el complejo.</p>
   <div class="hero-ctas anim anim-d4">
    <a class="btn-primary" href="https://app.vibe.com.ar/register" rel="noopener">Crear mi cuenta<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
    <a class="hero-link-secondary" href="#como-funciona">Ver cómo funciona</a>
   </div>
   <div class="hero-proof anim anim-d5">
    <span class="hero-proof-text">Para complejos de pádel, fútbol, tenis y otros deportes en <strong>Argentina</strong></span>
   </div>
   <div class="integration-bar anim anim-d5">
    <div class="integration-label">Cobros procesados por</div>
    <div class="mp-logo"><img src="/mercado-pago-logo.svg" alt="MercadoPago" width="160" height="36" loading="lazy"></div>
   </div>
  </div>
 </div>
</section>
