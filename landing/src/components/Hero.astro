---
import Screenshot from './Screenshot.astro';
import CourtLines from './CourtLines.astro';

/*
 * The bookings grid fills in turn by turn: it is the one animation on the page with
 * something to say, because a grid that fills on its own is the product.
 *
 * The picture is the real capture, untouched. What animates is a cover over each
 * booking, painted in the grid's own background and hour lines, that fades away in
 * the order the turns start. The boxes below are where each booking sits in the
 * capture, in its own pixels (1669x869); they were measured from the files in
 * public/screenshots, so a new capture of the grid needs them measured again. With reduced motion, or without CSS animations,
 * the covers are simply not there and the full grid shows.
 */
type Box = [x: number, y: number, w: number, h: number];

/* [left, top, right, bottom] of each booking's fill, one list per court column. */
const DESKTOP_COLUMNS: Array<{ x: [number, number]; turns: Array<[number, number]> }> = [
  { x: [256, 447], turns: [[177, 256], [261, 340], [429, 480], [569, 648], [708, 787], [792, 868]] },
  { x: [457, 647], turns: [[121, 228], [345, 424], [597, 676], [736, 815], [848, 868]] },
  { x: [657, 847], turns: [[233, 313], [541, 621], [682, 760], [792, 868]] },
  { x: [857, 1047], turns: [[205, 284], [625, 703], [708, 759], [764, 843], [848, 868]] },
  { x: [1057, 1247], turns: [[149, 228], [373, 452], [485, 564], [569, 648], [708, 815], [848, 868]] },
  { x: [1257, 1447], turns: [[149, 256], [317, 396], [401, 452], [569, 648], [764, 843], [848, 868]] },
];

/* Each cover reaches a little past the fill, over the booking's border and corners.
   Sorted by start time, then by court: the day fills from the morning down. */
function covers(columns: typeof DESKTOP_COLUMNS, bleed: number): Box[] {
  return columns
    .flatMap(({ x: [left, right], turns }) =>
      turns.map(([top, bottom]): Box => [left - bleed, top - bleed, right - left + 1 + bleed * 2, bottom - top + 1 + bleed * 2]))
    .sort((a, b) => a[1] - b[1] || a[0] - b[0]);
}
const desktopCovers = covers(DESKTOP_COLUMNS, 2);

---
<section class="hero" id="inicio">
 <div class="container hero-inner">
  <div class="hero-copy">
   <div class="section-label">Sistema de gestión para complejos deportivos</div>
   <h1>Gestioná tu complejo <em>gratis.</em></h1>
   <p class="hero-subtitle">Reservas con seña, cobros, caja por turno, bar con stock y reportes en un mismo panel. También turnos fijos, canchas libres y torneos.</p>
   <div class="hero-ctas">
    <a class="btn-primary" href="https://app.vibe.com.ar/register" rel="noopener">Crear mi cuenta gratis<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
    <a class="btn-secondary" href="#como-funciona">Ver cómo funciona</a>
   </div>
   <p class="hero-note">El cargo de servicio lo paga quien reserva, y lo ve antes de pagar.</p>
  </div>

  <!-- Both sides of the product in one picture: the owner's bookings grid, and the
       page a player books from on a phone. The grid is the largest thing in the first
       screen, so it loads eagerly. -->
  <div class="hero-visual">
   <!-- The court the two screens stand on, seen from its side line. -->
   <CourtLines class="hero-court" />
   <div class="shot shot--focus hero-panel" style="--fx:196;--fy:64">
    <div class="shot-canvas">
     <Screenshot variant="desktop" name="panel-reservas-canchas" alt="Grilla de reservas de Vibe con los turnos del día en cada cancha" eager />
     <svg class="grid-paint grid-paint--desktop" viewBox="0 0 1669 869" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <defs>
       <!-- The grid's background with its hour line, tiled from the 08:00 row down, so a
            cover continues the lines of the cells around it. -->
       <pattern id="grid-paint-desktop" patternUnits="userSpaceOnUse" x="0" y="120" width="1669" height="56">
        <rect width="1669" height="56" fill="#0b0b0b" />
        <rect width="1669" height="1" fill="#1e1e1e" />
       </pattern>
      </defs>
      {desktopCovers.map(([x, y, w, h], i) => (
       <rect class="grid-paint-cover" x={x} y={y} width={w} height={h} fill="url(#grid-paint-desktop)" style={`--i:${i}`} />
      ))}
      <!-- The "now" line runs over the bookings in the capture; redrawn here so the
           covers do not break it. -->
      <rect class="grid-paint-now" x="252" y="685" width="1200" height="1" fill="#f87171" />
     </svg>
    </div>
   </div>
   <div class="phone hero-phone">
    <Screenshot variant="single" name="reserva-celular-horarios" width={640} height={1378} alt="Página de reserva de un complejo vista desde el celular, con el día y los horarios para elegir" />
   </div>
  </div>

  <div class="hero-foot">
   <!-- What the stats strip used to say, folded into the hero: the one figure that is
        not a price. -->
   <div class="hero-proof">
    <span class="hero-proof-text">Tus clientes reservan con seña <strong>24/7</strong> desde el celular. Para complejos de pádel, fútbol, tenis y otros deportes en <strong>Argentina</strong>.</span>
   </div>
   <div class="pay-strip">
    <div class="integration-bar">
     <div class="integration-label">Señas online procesadas por</div>
     <div class="mp-logo"><img src="/mercado-pago-logo.svg" alt="MercadoPago" width="160" height="44" loading="lazy"></div>
    </div>
   </div>
  </div>
 </div>
</section>
