---
/**
 * Layout of the storefront routes (/c/*). It mirrors the app's PublicLayout and the
 * head of frontend/index.html, so a player sees the same page on vibe.com.ar as on
 * app.vibe.com.ar today: the mesh backdrop, the skip link, the header with the logo,
 * the main column and the "powered by" footer. The only stylesheet it imports is the
 * storefront one, so the hand-written pages never get the utilities.
 */
import '../styles/storefront.css';
import { Logo, MeshBackdrop } from '@vibe/ui';
import { BOOKING_MESSAGES } from '@vibe/booking/messages';
import { DEFAULT_SHARE_IMAGE } from '../lib/storefront.ts';

export interface Props {
  title: string;
  description: string;
  /** Absolute canonical URL. Omit it on pages that are not indexable. */
  canonical?: string | undefined;
  robots: string;
  ogTitle?: string | undefined;
  ogDescription?: string | undefined;
  ogUrl?: string | undefined;
  ogImage?: string | undefined;
  /** Serialized JSON-LD payloads, each in its own script element. */
  jsonLd?: string[] | undefined;
  /** Where the header logo goes: the complex's page on storefront pages. */
  homeHref?: string | undefined;
}

const {
  title,
  description,
  canonical,
  robots,
  ogTitle = title,
  ogDescription = description,
  ogUrl = canonical,
  ogImage = DEFAULT_SHARE_IMAGE,
  jsonLd = [],
  homeHref = '/',
} = Astro.props;

const t = BOOKING_MESSAGES.layout;

/* The app's inline critical CSS, so the first paint is already the dark ground. */
const criticalCss = `body{margin:0;background:#0b0b0b;color:#fff;font-family:'Inter',system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased;line-height:1.6}#root{min-height:100dvh;display:flex;flex-direction:column}`;
---
<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0b0b" />
    <style is:inline set:html={criticalCss} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vibe" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://api.vibe.com.ar" crossorigin />
    {jsonLd.map((block) => <script type="application/ld+json" is:inline set:html={block} />)}
    <slot name="head" />
  </head>
  <body>
    <div class="bg-bg-base relative flex min-h-dvh flex-col">
      <MeshBackdrop />

      <a href="#main-content" class="skip-link">{t.skipToContent}</a>

      <header class="border-border-subtle bg-bg-base safe-area-inset sticky top-0 z-40 flex h-16 shrink-0 items-center justify-between border-b px-4 sm:px-6">
        <a href={homeHref} class="flex min-h-11 min-w-11 items-center">
          <Logo />
        </a>
      </header>

      <main id="main-content" class="relative mx-auto flex w-full max-w-2xl flex-1 px-4 py-5 sm:p-8">
        <slot />
      </main>

      <footer class="border-border-subtle text-text-tertiary border-t py-8 text-center text-xs leading-4">
        {t.poweredBy}
      </footer>
    </div>
  </body>
</html>
