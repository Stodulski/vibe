---
/**
 * Una guía por URL, generada desde src/data/guias.ts.
 *
 * El orden del DOM es el orden de importancia y no es negociable: H1, la
 * respuesta completa, la fuente, y recién después el desarrollo. Quien llega
 * buscando el número lo tiene que ver sin scrollear, y lo mismo vale para un
 * motor que va a citar un fragmento y nada más.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { guias, comparaciones } from '../../data/guias';
import { guiaJsonLd } from '../../data/jsonld';

export function getStaticPaths() {
  return guias.map(guia => ({ params: { slug: guia.slug }, props: { guia } }));
}

const { guia } = Astro.props;
const canonical = `https://vibe.com.ar/guias/${guia.slug}`;
---
<BaseLayout
  title={guia.seoTitle}
  description={guia.metaDescription}
  canonical={canonical}
  date={guia.dateModified}
  ogTitle={guia.title}
  ogDescription={guia.metaDescription}
  ogUrl={canonical}
  ogImage="https://vibe.com.ar/og-image.png"
  ogImageWidth="1200"
  ogImageHeight="630"
  ogImageAlt="Vibe - Sistema de gestión para complejos deportivos"
  twitterCard="summary_large_image"
  twitterTitle={guia.title}
  twitterDescription={guia.metaDescription}
  twitterImage="https://vibe.com.ar/og-image.png"
  twitterImageAlt="Vibe - Sistema de gestión para complejos deportivos"
  jsonLd={guiaJsonLd(guia)}
  blobs={4}
  skipLink={true}
>
  <Nav startScrolled={true} linkPrefix="/" logoHref="/" />
  <main class="guia" id="inicio">
    <div class="container guia-inner">
      <nav aria-label="Ubicación" class="guia-breadcrumb">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href="/guias">Guías</a>
      </nav>

      <article class="guia-article">
        <header class="guia-header">
          <h1>{guia.title}</h1>
          {/* La respuesta va antes que cualquier otra cosa, a propósito. */}
          <p class="guia-respuesta">{guia.respuesta}</p>
          <p class="guia-meta">
            <span>Actualizado el {guia.dateModified}</span>
            {guia.fuente && (
              <>
                <span aria-hidden="true">·</span>
                <span>Fuente: <a href={guia.fuente.url} rel={guia.fuente.nofollow ? 'nofollow noopener' : 'noopener'} target="_blank">{guia.fuente.nombre}</a></span>
              </>
            )}
          </p>
        </header>

        {guia.bloques.map((bloque) => (
          <section class="guia-bloque">
            <h2>{bloque.heading}</h2>

            {/* set:html, no {p}: un parrafo puede traer un link de cruce a la otra
                guia (ver guias.ts), y el texto interpolado ahi ya viene autorizado
                por nosotros, nunca de un usuario. */}
            {bloque.tipo === 'parrafos' && bloque.parrafos.map(p => <p set:html={p} />)}

            {bloque.tipo === 'lista' && (
              <>
                {bloque.intro && <p>{bloque.intro}</p>}
                <ul class="guia-lista">{bloque.items.map(i => <li>{i}</li>)}</ul>
              </>
            )}

            {bloque.tipo === 'tabla' && (
              <>
                {bloque.intro && <p>{bloque.intro}</p>}
                {/* La tabla es el dato citable de la página, así que scrollea
                    sola en lugar de romper el ancho del documento. */}
                <div class="guia-tabla-scroll">
                  <table class="guia-tabla">
                    <thead>
                      <tr>{bloque.columnas.map(c => <th scope="col">{c}</th>)}</tr>
                    </thead>
                    <tbody>
                      {bloque.filas.map(fila => (
                        <tr>
                          {fila.map((celda, i) => (
                            i === 0 ? <th scope="row">{celda}</th> : <td>{celda}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                {bloque.nota && <p class="guia-nota">{bloque.nota}</p>}
              </>
            )}
          </section>
        ))}

        <section class="guia-bloque" id="preguntas">
          <h2>Preguntas frecuentes</h2>
          <div class="guia-faq">
            {guia.faq.map((item, i) => (
              <details class="faq-item guia-faq-item" open={i === 0}>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      </article>

      {(guia.comparacion || guia.verComparaciones) && comparaciones(guia.slug).length > 0 && (
        <aside class="guia-comparaciones">
          <h2>{guia.comparacion ? 'Otras comparaciones' : 'Comparaciones con otras plataformas'}</h2>
          <ul>
            {comparaciones(guia.slug).map(otra => (
              <li>
                <a href={`/guias/${otra.slug}`}>{otra.title}</a>
                <span>{otra.excerpt}</span>
              </li>
            ))}
          </ul>
        </aside>
      )}

      {guia.tutorial && (
        <aside class="guia-tutorial">
          <h2>Cómo funciona en el panel</h2>
          <p>
            <a href={`/tutoriales/${guia.tutorial.slug}`}>{guia.tutorial.texto}</a>, explicado paso a
            paso. También está el <a href="/tutoriales">resto de los tutoriales</a>.
          </p>
        </aside>
      )}

      <aside class="guia-cta">
        <h2>Más reservas para tu complejo, 100% gratis</h2>
        <p>
          Reservas con seña, cobros, caja y el stock del bar en un panel. Vibe no le cobra nada a tu
          complejo: ni abono ni costo fijo. Quién paga qué, en <a href="/#precio">el precio</a>.
        </p>
        <a class="btn-primary" href="https://app.vibe.com.ar/register" rel="noopener">
          Crear mi cuenta gratis
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </aside>
    </div>
  </main>
  <Footer linkPrefix="/" logoHref="/" />
</BaseLayout>
