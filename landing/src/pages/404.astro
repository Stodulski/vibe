---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="Página no encontrada | Vibe"
  description="La página que buscás no existe o fue movida. Volvé al inicio de Vibe, reservas online para tu complejo deportivo."
  canonical="https://vibe.com.ar/404"
  robots="noindex, follow"
  ogTitle="Página no encontrada | Vibe"
  ogDescription="La página que buscás no existe o fue movida."
  ogUrl="https://vibe.com.ar/404"
  ogImage="https://vibe.com.ar/og-image.png"
  ogImageWidth="1200"
  ogImageHeight="630"
  ogImageAlt="Vibe - Plataforma de gestión de complejos deportivos y reservas online"
  twitterCard="summary_large_image"
  twitterTitle="Página no encontrada | Vibe"
  twitterDescription="La página que buscás no existe o fue movida."
  twitterImage="https://vibe.com.ar/og-image.png"
  twitterImageAlt="Vibe - Plataforma de gestión de complejos deportivos y reservas online"
  blobs={4}
>
  <Nav startScrolled={true} linkPrefix="/" logoHref="/" />
  <main class="not-found">
    <div class="not-found-code" aria-hidden="true">404</div>
    <h1>Esta página no existe</h1>
    <p>Puede que el link esté roto o la página se haya movido. Volvé al inicio y seguí desde ahí.</p>
    <a class="btn-primary" href="/">Volver al inicio<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>
  </main>
  <Footer linkPrefix="/" logoHref="/" />
</BaseLayout>
