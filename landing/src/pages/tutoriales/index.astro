---
/**
 * El índice de tutoriales.
 *
 * Misma razón que el índice de guías: le da a los tutoriales un padre al que
 * enlazar desde el footer, y le da a un rastreador un solo lugar del que
 * salgan los siete. Un tutorial enlazado desde ningún lado depende del
 * sitemap y nada más, que es la forma más frágil de que lo encuentren.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { tutoriales, CDN, ULTIMA_ACTUALIZACION } from '../../data/tutoriales';
import { tutorialesIndexJsonLd } from '../../data/jsonld';

const TITULO = 'Tutoriales en video del panel de Vibe | Vibe';
const BAJADA = 'Siete videos cortos del panel de Vibe, cada uno una sola pantalla: '
  + 'la grilla, los precios, los clientes, los reportes y la configuración del complejo.';
---
<BaseLayout
  title={TITULO}
  description={BAJADA}
  canonical="https://vibe.com.ar/tutoriales"
  date={ULTIMA_ACTUALIZACION}
  ogTitle="Tutoriales en video del panel de Vibe"
  ogDescription={BAJADA}
  ogUrl="https://vibe.com.ar/tutoriales"
  ogImage="https://vibe.com.ar/og-image.png"
  ogImageWidth="1200"
  ogImageHeight="630"
  ogImageAlt="Vibe - Plataforma de gestión de complejos deportivos y reservas online"
  twitterCard="summary_large_image"
  twitterTitle="Tutoriales en video del panel de Vibe"
  twitterDescription={BAJADA}
  twitterImage="https://vibe.com.ar/og-image.png"
  twitterImageAlt="Vibe - Plataforma de gestión de complejos deportivos y reservas online"
  jsonLd={tutorialesIndexJsonLd(tutoriales)}
  blobs={4}
  skipLink={true}
>
  <Nav startScrolled={true} linkPrefix="/" logoHref="/" />
  <main class="tutorial" id="inicio">
    <div class="container tutorial-inner">
      <nav aria-label="Ubicación" class="tutorial-breadcrumb">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <span>Tutoriales</span>
      </nav>

      <header class="tutorial-header">
        <h1>Tutoriales</h1>
        <p class="tutorial-respuesta">{BAJADA}</p>
      </header>

      <section class="tutorial-bloque">
        <h2>Qué muestra cada video</h2>
        <p>
          Cada tutorial es una sola pantalla del panel de Vibe, grabada directamente
          sobre el producto real: sin guión leído y sin pantallas armadas para la
          cámara. Si estás evaluando Vibe y querés ver cómo se usa antes de cargar tu
          complejo, esta es la forma más rápida de hacerlo sin crear una cuenta.
        </p>
        <p>
          Son distintos de las <a href="/guias">guías</a>. Una guía contesta algo que
          se busca antes de saber que Vibe existe, con un número y una fuente. Un
          tutorial muestra una pantalla del panel funcionando, y su fuente es el
          producto mismo. Si lo que buscás es cuánto cuesta un sistema de reservas o
          cuánto cobra la pasarela de pago por una seña, esa respuesta está en las
          guías, no acá.
        </p>
      </section>

      <ul class="tutorial-index">
        {tutoriales.map(t => (
          <li class="tutorial-index-item">
            <a href={`/tutoriales/${t.slug}`}>
              <img
                src={`${CDN}/${t.slug}.webp`}
                alt={`Captura de pantalla del panel de Vibe: ${t.title}`}
                width="320"
                height="180"
                loading="lazy"
              />
              <div class="index-texto">
                <h2>{t.title}</h2>
                <p>{t.excerpt}</p>
                <span class="tutorial-index-meta">{t.duracion} segundos · Actualizado el {t.dateModified}</span>
              </div>
              <span class="index-cta">
                Ver el video
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
  <Footer linkPrefix="/" logoHref="/" />
</BaseLayout>
