---
/**
 * /c/<slug>/tournaments/<tournamentID>/inscripcion?category=<id>: the pair sign-up of one
 * category, laid out like the booking checkout (steps, ticket, form, pay). The tournament is
 * read in the browser and the query comes from the server so the island hydrates with the same
 * markup. Not indexed and never cached by a shared cache: it is one pair's checkout.
 */
import { TournamentSignUpEntry } from '@vibe/booking/tournament-signup';
import { SkeletonCancelInfo } from '@vibe/ui';
import { PUBLIC_API_URL } from 'astro:env/server';
import { BOOKING_MESSAGES } from '@vibe/booking/messages';
import StorefrontLayout from '../../../../../layouts/StorefrontLayout.astro';
import { DEFAULT_DESCRIPTION, storefrontBookingConfig, storefrontRobots } from '../../../../../lib/storefront.ts';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const tournamentId = Astro.params.tournamentID ?? '';
Astro.response.headers.set('Cache-Control', 'private, no-store');
const config = storefrontBookingConfig(PUBLIC_API_URL);
---
<StorefrontLayout
  title={`${BOOKING_MESSAGES.tournaments.pageTitle} - Vibe`}
  description={DEFAULT_DESCRIPTION}
  robots={storefrontRobots(Astro.url.pathname)}
  homeHref={`/c/${encodeURIComponent(slug)}`}
>
  <TournamentSignUpEntry client:load slug={slug} tournamentId={tournamentId} config={config} initialSearch={Astro.url.search}>
    <div slot="fallback" class="w-full" aria-busy="true">
      <SkeletonCancelInfo />
    </div>
  </TournamentSignUpEntry>
</StorefrontLayout>
