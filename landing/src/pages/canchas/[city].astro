---
/**
 * City hub at /canchas/[city], rendered on each request from the public API so it
 * always lists the live complexes. The answers are 200 for a city with complexes, and
 * 200 for a city whose last complex left (an empty hub: an owner block and the nearby
 * cities). A city that never had complexes is 404, and 503 with Retry-After when the
 * read fails. Indexing follows STOREFRONT_INDEXABLE; a city with fewer than two
 * complexes is followed but not indexed (hubRobots). The copy and JSON-LD come from lib/hub.ts.
 */
import { PUBLIC_API_URL } from 'astro:env/server';
import BookingLayout from '../../layouts/BookingLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ComplexCard from '../../components/ComplexCard.astro';
import { ApiError, API_TIMEOUT_MS, createPublicApi } from '../../lib/api.ts';
import { toHubView } from '../../lib/hub.ts';
import { robotsDirective } from '../../lib/storefront.ts';

export const prerender = false;

/** Longer city segments cannot name a city; they are answered as not found. */
const MAX_CITY_LENGTH = 100;

const errorCopy = {
  not_found: {
    title: 'Canchas no encontradas - Vibe',
    h1: 'No encontramos canchas en esta ciudad',
    lead: 'Todavía no hay complejos de Vibe en esta ciudad.',
  },
  unavailable: {
    title: 'Canchas no disponibles - Vibe',
    h1: 'No podemos mostrar las canchas ahora',
    lead: 'Tuvimos un problema para cargar esta ciudad. Probá de nuevo en un minuto.',
  },
};

const city = Astro.params.city ?? '';

let view: ReturnType<typeof toHubView> | null = null;
let errorKind: keyof typeof errorCopy = 'not_found';

if (city.length > 0 && city.length <= MAX_CITY_LENGTH) {
  try {
    const api = createPublicApi({ baseUrl: PUBLIC_API_URL, timeoutMs: API_TIMEOUT_MS });
    view = toHubView(await api.hubData(city));
  } catch (error) {
    errorKind = error instanceof ApiError && error.kind === 'not_found' ? 'not_found' : 'unavailable';
    if (errorKind === 'unavailable') console.error('city hub unavailable', error);
  }
}

const status = view ? 200 : errorKind === 'not_found' ? 404 : 503;
const copy = view ? null : errorCopy[errorKind];
const robots = view ? view.robots : robotsDirective(status);

Astro.response.status = status;
Astro.response.headers.set(
  'Cache-Control',
  view ? 'public, s-maxage=300, stale-while-revalidate=60' : 'no-store',
);
Astro.response.headers.set('X-Robots-Tag', robots);
if (status === 503) Astro.response.headers.set('Retry-After', '60');
---
<BookingLayout
  title={view ? view.title : copy!.title}
  description={view ? view.description : copy!.lead}
  canonical={view?.canonical}
  robots={robots}
  ogImage={view?.ogImage ?? undefined}
  jsonLd={view ? view.jsonLd : []}
>
  <Nav startScrolled={true} linkPrefix="/" logoHref="/" />
  <main id="contenido" class="mx-auto flex w-full max-w-3xl flex-col px-4 pb-16 pt-28 sm:pt-32">
    {view ? (
      <>
        <nav aria-label="Migas de pan" class="text-sm text-vibe-muted">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <li><a class="underline-offset-4 hover:underline" href="/">Inicio</a></li>
            <li aria-hidden="true">›</li>
            <li><a class="underline-offset-4 hover:underline" href="/canchas">Canchas</a></li>
            <li aria-hidden="true">›</li>
            <li aria-current="page">{view.city}</li>
          </ol>
        </nav>
        <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">{view.h1}</h1>
        {view.intro && <p class="mt-3 text-base text-vibe-muted">{view.intro}</p>}
        {view.empty && (
          <>
            <section class="mt-8 rounded-2xl border border-white/10 bg-white/[0.04] p-5 sm:p-6" aria-labelledby="sumar-complejo">
              <h2 id="sumar-complejo" class="text-xl font-bold tracking-tight">{view.empty.owner.heading}</h2>
              <p class="mt-2 text-base text-vibe-muted">{view.empty.owner.body}</p>
              <a
                href={view.empty.owner.href}
                rel="noopener"
                class="mt-5 inline-flex min-h-11 w-fit items-center rounded-full bg-vibe-green px-6 font-semibold text-vibe-bg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-vibe-green"
              >
                {view.empty.owner.cta}
              </a>
            </section>
            {view.empty.nearbyHeading && (
              <section class="mt-10" aria-labelledby="ciudades-cercanas">
                <h2 id="ciudades-cercanas" class="text-2xl font-bold tracking-tight">{view.empty.nearbyHeading}</h2>
                <ul class="mt-4 flex flex-col gap-3">
                  {view.empty.nearby.map((hub) => (
                    <li>
                      <a
                        href={hub.href}
                        class="flex min-h-11 flex-wrap items-center justify-between gap-x-4 gap-y-1 rounded-2xl border border-white/10 bg-white/[0.04] px-4 py-3 font-medium transition-colors hover:border-vibe-green/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-vibe-green"
                      >
                        <span>{hub.label}</span>
                        <span class="text-sm font-normal text-vibe-muted">{hub.countLabel}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </>
        )}
        {!view.empty && (
          <>
            <h2 class="mt-10 text-2xl font-bold tracking-tight">Complejos en {view.city}</h2>
            <ul class="mt-4 flex flex-col gap-3">
              {view.complexes.map((complex) => (
                <li>
                  <ComplexCard complex={complex} />
                </li>
              ))}
            </ul>
          </>
        )}
        {view.faq.length > 0 && (
          <section class="mt-12" aria-labelledby="preguntas-frecuentes">
            <h2 id="preguntas-frecuentes" class="text-2xl font-bold tracking-tight">Preguntas frecuentes</h2>
            <dl class="mt-4 flex flex-col gap-5">
              {view.faq.map((item) => (
                <div>
                  <dt class="font-semibold">{item.question}</dt>
                  <dd class="mt-1 text-vibe-muted">{item.answer}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}
        {!view.empty && view.otherHubs.length > 0 && (
          <section class="mt-12" aria-labelledby="otras-ciudades">
            <h2 id="otras-ciudades" class="text-2xl font-bold tracking-tight">Canchas en otras ciudades</h2>
            <ul class="mt-4 flex flex-wrap gap-2">
              {view.otherHubs.map((other) => (
                <li>
                  <a
                    href={other.href}
                    class="inline-flex min-h-11 items-center rounded-full border border-white/10 px-4 font-medium transition-colors hover:border-vibe-green/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-vibe-green"
                  >
                    {other.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
        <p class="mt-8 text-sm">
          <a class="font-semibold text-vibe-green underline-offset-4 hover:underline" href="/canchas">Ver todas las ciudades</a>
        </p>
      </>
    ) : (
      <>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{copy!.h1}</h1>
        <p class="mt-3 text-base text-vibe-muted">{copy!.lead}</p>
        <a
          href="/"
          class="mt-6 inline-flex min-h-11 w-fit items-center rounded-full bg-vibe-green px-6 font-semibold text-vibe-bg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-vibe-green"
        >
          Volvé al inicio
        </a>
      </>
    )}
  </main>
  <Footer linkPrefix="/" logoHref="/" />
</BookingLayout>
