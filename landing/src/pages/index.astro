---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LAST_MODIFIED } from '../data/site-dates';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import IntroSrOnly from '../components/IntroSrOnly.astro';
import Stats from '../components/Stats.astro';
import Problems from '../components/Problems.astro';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Pricing from '../components/Pricing.astro';
import Comparison from '../components/Comparison.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import { homeJsonLd } from '../data/jsonld';
---
<BaseLayout
  title="Sistema de gestión gratis para complejos deportivos | Vibe"
  description="Reservas, cobros, caja con arqueo, stock del bar, clientes y reportes en un solo panel. 100% gratis para tu complejo: Vibe no le cobra nada."
  canonical="https://vibe.com.ar"
  date={LAST_MODIFIED}
  appleTouchIcon="/apple-touch-icon.png"
  ogTitle="Vibe - La gestión de tu complejo, 100% gratis"
  ogDescription="Cobros, caja con arqueo, bar con stock, clientes, reportes y reservas con seña que entran solas. Vibe no le cobra nada a tu complejo. Nunca."
  ogUrl="https://vibe.com.ar"
  ogImage="https://vibe.com.ar/og-image.png"
  ogImageWidth="1200"
  ogImageHeight="630"
  ogImageAlt="Vibe - Sistema de gestión para complejos deportivos"
  twitterCard="summary_large_image"
  twitterTitle="Vibe - Sistema de gestión gratis para complejos deportivos"
  twitterDescription="Reservas, cobros, caja, stock del bar y reportes en un panel. 100% gratis para tu complejo."
  twitterImage="https://vibe.com.ar/og-image.png"
  twitterImageAlt="Vibe - Sistema de gestión para complejos deportivos"
  jsonLd={homeJsonLd}
  blobs={2}
  skipLink={true}
  tracking={true}
>
 <Nav />
 <main>
  <Hero />
  <IntroSrOnly />
  <Stats />
  <div aria-hidden="true" class="section-divider">
  </div>
  <Problems />
  <div aria-hidden="true" class="section-divider">
  </div>
  <Features />
  <div aria-hidden="true" class="section-divider"></div>
  <HowItWorks />
  <div aria-hidden="true" class="section-divider">
  </div>
  <Pricing />
  <div aria-hidden="true" class="section-divider">
  </div>
  <Comparison />
  <div aria-hidden="true" class="section-divider">
  </div>
  <Faq />
  <div aria-hidden="true" class="section-divider">
  </div>
  <FinalCta />
 </main>
 <Footer />
</BaseLayout>
