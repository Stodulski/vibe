---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LAST_MODIFIED } from '../data/site-dates';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import IntroSrOnly from '../components/IntroSrOnly.astro';
import Stats from '../components/Stats.astro';
import Problems from '../components/Problems.astro';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Pricing from '../components/Pricing.astro';
import Comparison from '../components/Comparison.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import { homeJsonLd } from '../data/jsonld';
---
<BaseLayout
  title="Reservas online de canchas, gratis para tu complejo | Vibe"
  description="Reservas online y cobro de señas con MercadoPago para complejos de pádel, fútbol y tenis en Argentina. $0 de costo fijo para el complejo."
  canonical="https://vibe.com.ar"
  date={LAST_MODIFIED}
  appleTouchIcon="/apple-touch-icon.png"
  ogTitle="Vibe - Tus clientes reservan cancha y pagan desde el celular | Gratis para tu complejo"
  ogDescription="Tus clientes reservan cancha y pagan la seña desde el celular. Vos recibís la plata y gestionás todo desde un panel. $0 de costo fijo para el complejo."
  ogUrl="https://vibe.com.ar"
  ogImage="https://vibe.com.ar/og-image.png"
  ogImageWidth="1200"
  ogImageHeight="630"
  ogImageAlt="Vibe - Plataforma de gestión de complejos deportivos y reservas online"
  twitterCard="summary_large_image"
  twitterTitle="Vibe - Reservas y cobros automáticos para tu complejo deportivo"
  twitterDescription="Tus clientes reservan cancha y pagan la seña desde el celular. Panel de control, cobros con MercadoPago y recordatorios automáticos. $0 de costo fijo."
  twitterImage="https://vibe.com.ar/og-image.png"
  twitterImageAlt="Vibe - Plataforma de gestión de complejos deportivos y reservas online"
  jsonLd={homeJsonLd}
  blobs={2}
  skipLink={true}
  tracking={true}
>
 <Nav />
 <main>
  <Hero />
  <IntroSrOnly />
  <Stats />
  <div aria-hidden="true" class="section-divider">
  </div>
  <Problems />
  <div aria-hidden="true" class="section-divider">
  </div>
  <Features />
  <div aria-hidden="true" class="section-divider"></div>
  <HowItWorks />
  <div aria-hidden="true" class="section-divider">
  </div>
  <Pricing />
  <div aria-hidden="true" class="section-divider">
  </div>
  <Comparison />
  <div aria-hidden="true" class="section-divider">
  </div>
  <Faq />
  <div aria-hidden="true" class="section-divider">
  </div>
  <FinalCta />
 </main>
 <Footer />
</BaseLayout>
